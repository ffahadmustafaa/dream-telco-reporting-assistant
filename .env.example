# Copy to .env (local dev) or set as environment variables on Vercel.
# Never commit real values to git.

# --- Firebase Admin (service account JSON from Firebase Console > Project settings > Service accounts) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Keep the literal \n newlines; the server restores them automatically.

# --- App sessions ---
JWT_SECRET=            # long random string, e.g. output of: openssl rand -hex 32

# --- Report email (daily 22:30 PKT report) ---
REPORT_EMAIL_PROVIDER=      # resend | smtp | none
REPORT_EMAIL_API_KEY=
REPORT_EMAIL_FROM=          # e.g. reports@yourdomain.com
REPORT_EMAIL_TO=            # comma-separated recipients, e.g. ops@example.com,admin@example.com

# --- Scheduled report cron secret ---
REPORT_CRON_SECRET=    # random string; Vercel cron / external cron sends it as a Bearer token

# --- Optional: AI assistant LLM fallback (OpenAI-compatible chat completions API) ---
LLM_API_URL=           # e.g. https://api.openai.com
LLM_API_KEY=
LLM_MODEL=             # e.g. gpt-4o-mini

# --- Optional: sandbox login for local development ---
VITE_DEV_LOGIN_OPEN_ID=
DEV_SANDBOX_ADMIN_PASSWORD=
