rules_version = '2';

// Dream Telco Reporting Assistant — Firestore security rules.
//
// All data access goes through the server (Firebase Admin SDK), which bypasses
// these rules. Direct client access is denied entirely: the web app talks to
// Firestore only via the /api/* tRPC routes, which authenticate with the
// first-party HS256 session cookie.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
